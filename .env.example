# Razorpay — Test Mode only. Never use live keys here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Get from Razorpay Dashboard → Settings → Webhooks → (create or edit webhook) → Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# OpenRouter API (openrouter.ai) — OpenAI-compatible endpoint
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — locks CORS to your deployed Next.js origin (e.g. https://nimbus-gear.vercel.app)
# Required when APP_ENV=production. Local development defaults to http://localhost:3000.
FRONTEND_ORIGIN=

# Runtime / deployment configuration
APP_ENV=development
# In production, the FastAPI root redirects to this canonical Next.js frontend.
FRONTEND_PUBLIC_URL=

# Required only for the private presenter reset command. Never expose this value
# in the browser, frontend environment variables, logs, or source control.
DEMO_RESET_TOKEN=replace-with-a-long-random-presenter-only-token

# Optional — change where SQLite is stored (e.g. Railway persistent volume)
# DB_PATH=/storage/audit.db
